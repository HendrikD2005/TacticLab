# Microsoft Foundry Models. Disabled until explicitly configured.
# Resource inference URL, not the Foundry project/portal URL.
AI_ENABLED=false
AZURE_AI_BASE_URL=https://YOUR-RESOURCE.openai.azure.com/openai/v1/
AZURE_AI_API_KEY=
AZURE_AI_DEPLOYMENT=
# Counts every outgoing model request (at most four per analysis).
# Per-process safeguard, not a shared billing cap.
AI_MAX_CALLS_PER_HOUR=20
